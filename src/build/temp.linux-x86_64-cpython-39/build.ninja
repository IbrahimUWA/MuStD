ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -B /home/ibrahim/anaconda3/envs/tedclone/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/ibrahim/anaconda3/envs/tedclone/include -I/home/ibrahim/anaconda3/envs/tedclone/include -fPIC -O2 -isystem /home/ibrahim/anaconda3/envs/tedclone/include -fPIC -I/home/ibrahim/anaconda3/envs/tedclone/lib/python3.9/site-packages/torch/include -I/home/ibrahim/anaconda3/envs/tedclone/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/ibrahim/anaconda3/envs/tedclone/lib/python3.9/site-packages/torch/include/TH -I/home/ibrahim/anaconda3/envs/tedclone/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda/include -I/home/ibrahim/anaconda3/envs/tedclone/include/python3.9 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=pointnet2_batch_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14
cuda_cflags = -I/home/ibrahim/anaconda3/envs/tedclone/lib/python3.9/site-packages/torch/include -I/home/ibrahim/anaconda3/envs/tedclone/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/ibrahim/anaconda3/envs/tedclone/lib/python3.9/site-packages/torch/include/TH -I/home/ibrahim/anaconda3/envs/tedclone/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda/include -I/home/ibrahim/anaconda3/envs/tedclone/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=pointnet2_batch_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -std=c++14
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags



